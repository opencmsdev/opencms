{
  "name": "opencms",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencmsdev/opencms.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test packages",
    "test:unit": "bun test packages",
    "test:e2e": "bun run build:admin && bun run --cwd apps/admin e2e",
    "test:all": "bun run typecheck && bun run test:unit && bun run test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json",
    "dev": "bun run apps/dev/index.ts",
    "build:admin": "bun run --cwd apps/admin build",
    "e2e": "bun run --cwd apps/admin e2e",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "sync:version": "bun run scripts/sync-version.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
